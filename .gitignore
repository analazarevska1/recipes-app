# Dependencies
/node_modules
/vendor
/public/hot
/public/storage
/public/build
/storage/*.key
/storage/pail

# Environment files (never commit secrets)
.env
.env.backup
.env.production
.env.local
auth.json

# Local SQLite database (let each developer have their own)
/database/*.sqlite
/database/*.sqlite-journal

# Logs
*.log
/storage/logs/*
!/storage/logs/.gitkeep

# Cache
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Editor / IDE
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.phpactor.json
.phpunit.result.cache
/.phpunit.cache

# OS files
.DS_Store
Thumbs.db
__MACOSX

# Homestead
Homestead.json
Homestead.yaml

# Tooling cache
/.php-cs-fixer.cache
